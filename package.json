{
  "name": "genkai-recipe-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "^56.0.13",
    "expo": "^51.0.0",
    "expo-status-bar": "~1.12.1",
    "nativewind": "^4.2.4",
    "react": "18.2.0",
    "react-dom": "^19.2.6",
    "react-native": "0.74.5",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.14",
    "jest": "~29.7.0",
    "jest-expo": "^56.0.4",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
